local panthera = require("panthera.panthera")
local animation = require("first_anim.first_anim_panthera")

-- One-shot clips: never loop, no matter what the Loop toggle says.
-- They are authored to look good when replayed rapidly.
local NO_LOOP = {
	attack = true,
}

function init(self)
	-- Keep aspect ratio on window resize
	msg.post("@render:", "use_fixed_fit_projection")

	-- Drive the "human" collection instance with Panthera
	self.anim = panthera.create_go(animation, "human")
	
	-- State machine tracking
	self.base_anim = "default"
	self.base_loop = true
	self.is_playing_action = false

	panthera.play(self.anim, self.base_anim, { is_loop = self.base_loop })
end

function on_message(self, message_id, message)
	if message_id == hash("play_anim") then
		-- "damage" is an OVERLAY: it only drives the "hit" / "head_pivot" layer
		-- nodes, which no base clip touches, so we play it detached on top of
		-- whatever is currently running (idle / walk / attack) without
		-- interrupting it. It returns to rest and cleans itself up on finish.
		if message.anim == "damage" then
			panthera.play_detached(self.anim, "damage")
			return
		end

		-- "attack" is a ONE-SHOT ACTION: it interrupts the base animation,
		-- but it is only allowed to start from the IDLE ("default") state.
		if message.anim == "attack" then
			if self.base_anim == "default" then
				self.is_playing_action = true
				panthera.play(self.anim, "attack", {
					is_loop = false,
					callback = function()
						self.is_playing_action = false
						-- Return to the base state (which will be "default")
						panthera.play(self.anim, self.base_anim, { is_loop = self.base_loop })
					end
				})
			else
				print("Attack is ignored because the character is not in IDLE state.")
			end
			return
		end

		-- "death" is a TERMINAL STATE: it permanently overrides action state
		if message.anim == "death" then
			self.base_anim = "death"
			self.base_loop = message.loop
			self.is_playing_action = false
			panthera.play(self.anim, "death", { is_loop = message.loop })
			return
		end

		-- Otherwise, we are changing the base state (default/walk)
		local loop = message.loop and not NO_LOOP[message.anim]
		self.base_anim = message.anim
		self.base_loop = loop

		-- Only update the current active animation if we aren't mid-attack
		if not self.is_playing_action then
			panthera.play(self.anim, message.anim, { is_loop = loop })
		end
	end
end
