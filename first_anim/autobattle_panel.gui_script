local skins = require("first_anim.skins")
local theme = require("first_anim.theme")

local CONTROLLER = "/system#autobattle"

local function flash_node(node)
	gui.animate(node, "color.w", 0.5, gui.EASING_OUTQUAD, 0.06, 0, function()
		gui.animate(node, "color.w", 1.0, gui.EASING_OUTQUAD, 0.15)
	end)
end

-- Index of an attachment id within a UI list ({ id, label } entries).
local function index_of(list, id)
	for i, entry in ipairs(list) do
		if entry.id == id then return i end
	end
	return 1
end

local function current_id(self, slot)
	return self.slots[slot].list[self.slots[slot].idx].id
end

local function update_equip_ui(self)
	for slot, data in pairs(self.slots) do
		gui.set_text(data.label, data.list[data.idx].label)
	end
end

local function post_loadout(self)
	msg.post(CONTROLLER, "equip_player", {
		weapon = current_id(self, "weapon"),
		body = current_id(self, "body"),
		head = current_id(self, "head"),
	})
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.status_lbl = gui.get_node("status_lbl")
	self.log_text = gui.get_node("log_text")

	self.speed_buttons = {
		[1] = gui.get_node("speed_1x"),
		[2] = gui.get_node("speed_2x"),
		[4] = gui.get_node("speed_4x"),
	}
	self.active_speed = 0

	self.btn_pause = gui.get_node("btn_pause")
	self.lbl_pause = gui.get_node("lbl_pause")
	self.btn_restart = gui.get_node("btn_restart")

	self.group_buttons = {
		[1] = gui.get_node("btn_group1"),
		[2] = gui.get_node("btn_group2"),
		[3] = gui.get_node("btn_group3"),
	}
	self.active_group = 1

	-- Equipment selectors are driven entirely by skins.json (UI-flagged entries).
	self.slots = {
		weapon = { list = skins.get_ui_list("weapon"), idx = 1, node = gui.get_node("btn_equip_weapon"), label = gui.get_node("lbl_equip_weapon") },
		body   = { list = skins.get_ui_list("body"),   idx = 1, node = gui.get_node("btn_equip_body"),   label = gui.get_node("lbl_equip_body") },
		head   = { list = skins.get_ui_list("head"),   idx = 1, node = gui.get_node("btn_equip_head"),   label = gui.get_node("lbl_equip_head") },
	}
	update_equip_ui(self)

	self.color_active = theme.color.ui_active
	self.color_inactive = theme.color.ui_inactive
end

function on_message(self, message_id, message)
	if message_id == hash("update_logs") then
		gui.set_text(self.log_text, table.concat(message.logs, "\n"))

	elseif message_id == hash("set_status") then
		gui.set_text(self.status_lbl, message.text)
		if message.color then
			gui.set_color(self.status_lbl, message.color)
		end

	elseif message_id == hash("speed_changed") then
		self.active_speed = message.speed
		gui.set_color(self.btn_pause, self.active_speed == 0 and self.color_active or self.color_inactive)
		for speed_val, node in pairs(self.speed_buttons) do
			gui.set_color(node, speed_val == self.active_speed and self.color_active or self.color_inactive)
		end

	elseif message_id == hash("group_changed") then
		self.active_group = message.group_id
		for group_val, node in pairs(self.group_buttons) do
			gui.set_color(node, group_val == self.active_group and self.color_active or self.color_inactive)
		end

	elseif message_id == hash("init_equipment") then
		self.slots.weapon.idx = index_of(self.slots.weapon.list, message.weapon)
		self.slots.body.idx = index_of(self.slots.body.list, message.body)
		self.slots.head.idx = index_of(self.slots.head.list, message.head)
		update_equip_ui(self)
	end
end

local function cycle_slot(self, slot)
	local data = self.slots[slot]
	data.idx = (data.idx % #data.list) + 1
	update_equip_ui(self)
	post_loadout(self)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return
	end

	if gui.pick_node(self.btn_restart, action.x, action.y) then
		flash_node(self.btn_restart)
		msg.post(CONTROLLER, "restart")
		return
	end

	if gui.pick_node(self.btn_pause, action.x, action.y) then
		flash_node(self.btn_pause)
		msg.post(CONTROLLER, "set_speed", { speed = 0 })
		return
	end

	for speed_val, btn in pairs(self.speed_buttons) do
		if gui.pick_node(btn, action.x, action.y) then
			flash_node(btn)
			msg.post(CONTROLLER, "set_speed", { speed = speed_val })
			return
		end
	end

	for group_val, btn in pairs(self.group_buttons) do
		if gui.pick_node(btn, action.x, action.y) then
			flash_node(btn)
			msg.post(CONTROLLER, "select_group", { group_id = group_val })
			return
		end
	end

	for slot, data in pairs(self.slots) do
		if gui.pick_node(data.node, action.x, action.y) then
			flash_node(data.node)
			cycle_slot(self, slot)
			return
		end
	end
end
