local panthera = require("panthera.panthera")
local animation = require("first_anim.first_anim_panthera")
local skins = require("first_anim.skins")

local FLASH_NODES = {
	"body", "head", "hand_right", "hand_left", "left_leg", "right_leg",
	"weapon_impact", "weapon_pistol", "weapon_rifle", "weapon_shotgun", "weapon_stabbing"
}

local function play_flash(prefix)
	for _, id in ipairs(FLASH_NODES) do
		local url = msg.url(nil, "/" .. prefix .. "/" .. id, "sprite")
		pcall(function()
			go.set(url, "flash", vmath.vector4(1, 0, 0, 0))
			go.animate(url, "flash", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(0, 0, 0, 0), go.EASING_LINEAR, 0.3, 0)
		end)
	end
end

local function play_muzzle(prefix, wtype)
	if wtype ~= "pistol" and wtype ~= "rifle" and wtype ~= "shotgun" then return end
	local url_flash = msg.url(nil, hash("/" .. prefix .. "/weapon_" .. wtype), hash("muzzle_flash"))
	local url_smoke = msg.url(nil, hash("/" .. prefix .. "/weapon_" .. wtype), hash("smoke_puff"))
	local function fire()
		pcall(function()
			particlefx.stop(url_flash)
			particlefx.stop(url_smoke)
			particlefx.play(url_flash)
			particlefx.play(url_smoke)
		end)
	end
	if wtype == "pistol" then
		timer.delay(0.1, false, function() fire() end)
	elseif wtype == "shotgun" then
		fire()
	elseif wtype == "rifle" then
		fire()
		timer.delay(0.13, false, function() fire() end)
		timer.delay(0.26, false, function() fire() end)
	end
end

local function apply_damage(self, defender, amount)
	local hp_var = defender .. "_hp"
	local current_hp = self[hp_var]
	if current_hp <= 0 then return end

	local new_hp = math.max(0, current_hp - amount)
	self[hp_var] = new_hp

	msg.post("/ui#panel", "update_hp", { character = defender, hp = new_hp })

	local target_anim = (defender == "player") and self.player_anim or self.enemy_anim
	local target_overlay = (defender == "player") and self.player_overlay or self.enemy_overlay

	if new_hp <= 0 then
		-- Kill the defender
		self[defender .. "_is_acting"] = false
		msg.post("/ui#panel", "lock_controls", { character = defender, lock = true })
		panthera.play(target_anim, "death", { is_loop = false })
	else
		-- Play hit reaction
		panthera.play(target_overlay, "damage", { is_loop = false })
		play_flash(defender)
	end
end

local function heal_character(self, character)
	local hp_var = character .. "_hp"
	self[hp_var] = 100

	msg.post("/ui#panel", "update_hp", { character = character, hp = 100 })
	msg.post("/ui#panel", "lock_controls", { character = character, lock = false })

	self[character .. "_is_acting"] = false

	local target_anim = (character == "player") and self.player_anim or self.enemy_anim
	panthera.play(target_anim, "default", { is_loop = true })
end

function init(self)
	msg.post("@render:", "use_fixed_fit_projection")

	-- Create independent animation states for player and enemy
	self.player_anim = panthera.create_go(animation, "player")
	self.enemy_anim = panthera.create_go(animation, "enemy")

	-- Overlay hit reaction states
	self.player_overlay = panthera.create_go(animation, "player")
	self.enemy_overlay = panthera.create_go(animation, "enemy")

	-- Apply defaults
	skins.apply_defaults("player")
	skins.apply_defaults("enemy")

	-- Initial state: idle
	panthera.play(self.player_anim, "default", { is_loop = true })
	panthera.play(self.enemy_anim, "default", { is_loop = true })

	-- Status variables
	self.player_hp = 100
	self.enemy_hp = 100
	self.player_weapon_type = "impact"
	self.enemy_weapon_type = "impact"
	self.player_is_acting = false
	self.enemy_is_acting = false

	msg.post(".", "acquire_input_focus")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("apply_skin_attachment") then
		skins.apply_attachment(message.character, message.slot, message.attachment_id)
		if message.slot == "weapon" then
			local wtype = skins.get_weapon_type(message.attachment_id)
			if wtype then
				self[message.character .. "_weapon_type"] = wtype
			end
		end
		return
	end

	if message_id == hash("attack") then
		local char = message.character
		local target = (char == "player") and "enemy" or "player"

		-- Validation
		if self[char .. "_hp"] <= 0 or self[target .. "_hp"] <= 0 or self[char .. "_is_acting"] then
			return
		end

		self[char .. "_is_acting"] = true
		msg.post("/ui#panel", "lock_controls", { character = char, lock = true })

		local wtype = self[char .. "_weapon_type"]
		local anim_state = (char == "player") and self.player_anim or self.enemy_anim
		local start_x = (char == "player") and 600 or 1320
		local attack_x = (char == "player") and 1020 or 900
		local go_url = "/" .. char .. "/root"

		local is_melee = (wtype == "impact" or wtype == "stabbing")

		if is_melee then
			-- Bring attacker to front by increasing Z
			local pos = go.get_position(go_url)
			pos.z = 0.5
			go.set_position(pos, go_url)

			-- Step forward
			panthera.play(anim_state, "walk", { is_loop = true })
			go.animate(go_url, "position.x", go.PLAYBACK_ONCE_FORWARD, attack_x, go.EASING_LINEAR, 0.45, 0, function()
				-- Attack
				panthera.play(anim_state, "attack_" .. wtype, {
					is_loop = false,
					callback = function()
						-- Walk back
						panthera.play(anim_state, "walk", { is_loop = true })
						go.animate(go_url, "position.x", go.PLAYBACK_ONCE_FORWARD, start_x, go.EASING_LINEAR, 0.45, 0, function()
							panthera.play(anim_state, "default", { is_loop = true })
							self[char .. "_is_acting"] = false
							msg.post("/ui#panel", "lock_controls", { character = char, lock = false })

							-- Restore default Z depth
							local back_pos = go.get_position(go_url)
							back_pos.z = (char == "player") and 0.0 or -0.1
							go.set_position(back_pos, go_url)
						end)
					end
				})
				-- Melee impact delay
				local impact_delay = (wtype == "impact") and 0.42 or 0.3
				timer.delay(impact_delay, false, function()
					apply_damage(self, target, 25)
				end)
			end)
		else
			-- Shoot in place
			play_muzzle(char, wtype)
			panthera.play(anim_state, "attack_" .. wtype, {
				is_loop = false,
				callback = function()
					panthera.play(anim_state, "default", { is_loop = true })
					self[char .. "_is_acting"] = false
					msg.post("/ui#panel", "lock_controls", { character = char, lock = false })
				end
			})
			-- Gun hit delay
			timer.delay(0.12, false, function()
				apply_damage(self, target, 20)
			end)
		end
		return
	end

	if message_id == hash("heal") then
		heal_character(self, message.character)
		return
	end
end
