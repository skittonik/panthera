local panthera = require("panthera.panthera")
local animation = require("first_anim.first_anim_panthera")

-- Rest pose values for the parts the walk moves, used to settle out of the walk
local WALK_REST = {
	{ "left_leg", "euler.z", 0 },
	{ "right_leg", "euler.z", 0 },
	{ "body", "position.y", 70 },
	{ "head", "position.y", 240 },
	{ "head", "euler.z", 0 },
	{ "baseball_bat", "euler.z", 0 },
	{ "baseball_bat", "position.y", 129 },
}

-- Quickly ease the walk pose back to rest, then start idle.
-- Fast (0.15s) and smooth - avoids Panthera's instant reset snap.
local function blend_walk_to_idle(anim, prefix, on_done)
	panthera.stop(anim)
	local blend = 0.15
	for i = 1, #WALK_REST do
		local r = WALK_REST[i]
		go.animate("/" .. prefix .. "/" .. r[1], r[2], go.PLAYBACK_ONCE_FORWARD, r[3], go.EASING_OUTQUAD, blend)
	end
	timer.delay(blend, false, function()
		panthera.play(anim, "default", { is_loop = true })
		if on_done then on_done() end
	end)
end

function init(self)
	-- Use fixed fit projection to maintain aspect ratio on window resize
	msg.post("@render:", "use_fixed_fit_projection")

	-- Create independent animation states for player and enemy
	self.player_anim = panthera.create_go(animation, "player")
	self.enemy_anim = panthera.create_go(animation, "enemy")

	-- Initial states: both idle
	panthera.play(self.player_anim, "default", { is_loop = true })
	panthera.play(self.enemy_anim, "default", { is_loop = true })

	self.battle_step = 0
	self.is_animating = false

	msg.post(".", "acquire_input_focus")
end

function final(self)
	-- Clean up timers if any
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed and not self.is_animating then
		self.battle_step = self.battle_step + 1
		self.is_animating = true

		if self.battle_step == 1 then
			-- STEP 1: Player steps forward a little (stays opposite the enemy)
			print("Step 1: Player steps toward Enemy")
			panthera.play(self.player_anim, "walk", { is_loop = true, speed = 0.65 })
			go.animate("/player/root", "position.x", go.PLAYBACK_ONCE_FORWARD, 180, go.EASING_LINEAR, 0.8, 0, function()
				blend_walk_to_idle(self.player_anim, "player", function()
					self.is_animating = false
				end)
			end)

		elseif self.battle_step == 2 then
			-- STEP 2: Player attacks, Enemy gets damaged
			print("Step 2: Player attacks, Enemy takes damage")
			panthera.play(self.player_anim, "attack", { is_loop = false })

			-- Delay damage animation to sync with the bat strike (impact ~0.42)
			timer.delay(0.42, false, function()
				panthera.play_detached(self.enemy_anim, "damage")
				timer.delay(0.55, false, function()
					self.is_animating = false
				end)
			end)

		elseif self.battle_step == 3 then
			-- STEP 3: Enemy steps toward the player (moves left) and counter-attacks
			print("Step 3: Enemy approaches and counter-attacks")
			panthera.play(self.enemy_anim, "walk", { is_loop = true, speed = 0.65 })
			go.animate("/enemy/root", "position.x", go.PLAYBACK_ONCE_FORWARD, -180, go.EASING_LINEAR, 0.8, 0, function()
				-- is_skip_init blends out of the walk instead of snapping to rest
				panthera.play(self.enemy_anim, "attack", { is_loop = false, is_skip_init = true })

				-- Delay damage to sync with the bat strike (impact ~0.42)
				timer.delay(0.42, false, function()
					panthera.play_detached(self.player_anim, "damage")
					timer.delay(0.55, false, function()
						self.is_animating = false
					end)
				end)
			end)

		elseif self.battle_step == 4 then
			-- STEP 4: Player finishes the Enemy, Enemy dies
			print("Step 4: Player slashes and Enemy dies")
			panthera.play(self.player_anim, "attack", { is_loop = false })

			-- Delay death animation to sync with the bat strike (impact ~0.42)
			timer.delay(0.42, false, function()
				panthera.play(self.enemy_anim, "death", { is_loop = false })
				timer.delay(1.0, false, function()
					self.is_animating = false
				end)
			end)

		elseif self.battle_step == 5 then
			-- STEP 5: Reset fight (Player turns around, walks back, Enemy revives)
			print("Step 5: Resetting scene")
			-- Face left so the walk-back isn't a moonwalk
			-- (go.set_scale forbids negative components, so flip via scale.x)
			go.set("/player/root", "scale.x", -1)
			panthera.play(self.player_anim, "walk", { is_loop = true, speed = 0.65 })
			go.animate("/player/root", "position.x", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 0.8, 0, function()
				-- Face right again, ready for the next fight
				go.set("/player/root", "scale.x", 1)

				-- Reset Enemy back to its starting spot and revive it
				go.set_position(vmath.vector3(0, 0, 0), "/enemy/root")
				panthera.play(self.enemy_anim, "default", { is_loop = true })

				blend_walk_to_idle(self.player_anim, "player", function()
					self.battle_step = 0
					self.is_animating = false
				end)
			end)
		end
	end
end
