local CONTROLLER = "/controller#sandbox"

local function play(anim)
	msg.post(CONTROLLER, "play_anim", { anim = anim })
end

function init(self)
	msg.post(".", "acquire_input_focus")

	-- States act as radio buttons: only one can be active at a time
	self.states = {
		default = gui.get_node("btn_default"),
		walk = gui.get_node("btn_walk"),
		death = gui.get_node("btn_death"),
	}

	-- Actions act as simple triggers: they flash on click, but don't hold state
	self.actions = {
		attack = gui.get_node("btn_attack"),
		damage = gui.get_node("btn_damage"),
	}

	self.active_state = "default"
	
	-- Apply initial selection visuals
	self:update_visuals()
end

function update_visuals(self)
	for anim, node in pairs(self.states) do
		-- Selected state is fully bright (alpha=1.0), others are dimmed (alpha=0.45)
		local alpha = (anim == self.active_state) and 1.0 or 0.45
		gui.animate(node, "color.w", alpha, gui.EASING_OUTQUAD, 0.2)
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return
	end

	-- Check states click
	for anim, node in pairs(self.states) do
		if gui.pick_node(node, action.x, action.y) then
			if self.active_state ~= anim then
				self.active_state = anim
				self:update_visuals()
				play(anim)
			end
			return
		end
	end

	-- Check actions click
	for anim, node in pairs(self.actions) do
		if gui.pick_node(node, action.x, action.y) then
			-- Flash action button briefly
			gui.animate(node, "color.w", 0.5, gui.EASING_OUTQUAD, 0.06, 0, function()
				gui.animate(node, "color.w", 1.0, gui.EASING_OUTQUAD, 0.15)
			end)
			play(anim)
			return
		end
	end
end
