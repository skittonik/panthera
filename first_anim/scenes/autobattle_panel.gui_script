local skins = require("first_anim.modules.skins")
local weapons = require("first_anim.modules.weapons")
local theme = require("first_anim.modules.theme")

local CONTROLLER = "/system#autobattle"

local EQUIP_COLOR = vmath.vector4(0.18, 0.22, 0.28, 1.0)
local BATTLE_COUNT = 3 -- the 3 fights of a wave (matches waves.json)

local function flash_node(node)
	gui.animate(node, "color.w", 0.5, gui.EASING_OUTQUAD, 0.06, 0, function()
		gui.animate(node, "color.w", 1.0, gui.EASING_OUTQUAD, 0.15)
	end)
end

-- Paint a toggle button: teal when active, grey otherwise, dimmed when locked.
local function paint(node, active, enabled)
	local c = active and theme.color.ui_active or theme.color.ui_inactive
	gui.set_color(node, vmath.vector4(c.x, c.y, c.z, enabled and 1.0 or 0.4))
end

local function index_of(list, id)
	for i, entry in ipairs(list) do
		if entry.id == id then return i end
	end
	return 1
end

local function current_id(self, slot)
	return self.slots[slot].list[self.slots[slot].idx].id
end

-- A battle is "in progress" (running or paused) - battle/wave are locked then.
local function battle_locked(self)
	return self.phase == "running" or self.phase == "paused"
end

-- Refresh ---------------------------------------------------------------------

local function refresh_play_pause(self)
	local running = (self.phase == "running")
	paint(self.btn_play, running, true)
	paint(self.btn_pause, not running, true)
end

local function refresh_speed(self)
	for speed_val, node in pairs(self.speed_buttons) do
		paint(node, speed_val == self.active_speed, true)
	end
end

local function refresh_run(self)
	paint(self.btn_run, self.run_mode, true)
end

-- Battle / wave selectors: update labels and dim the arrows while locked.
local function refresh_select(self)
	gui.set_text(self.lbl_battle, string.format("BATTLE %d/%d", self.active_battle, BATTLE_COUNT))
	gui.set_text(self.lbl_wave, string.format("WAVE %d", self.wave))
	local alpha = battle_locked(self) and 0.35 or 1.0
	for _, node in ipairs(self.select_arrows) do
		local c = gui.get_color(node)
		c.w = alpha
		gui.set_color(node, c)
	end
end

-- Power readout: "YOU: n  ENEMIES: n", tinted green/red by who's ahead.
local function refresh_power(self)
	gui.set_text(self.lbl_power, string.format("POWER  YOU: %d   ENEMIES: %d", self.player_power, self.enemy_power))
	local c = (self.player_power >= self.enemy_power) and theme.color.status_victory or theme.color.status_defeat
	gui.set_color(self.lbl_power, c)
end

local function refresh_equip(self)
	local alpha = (self.phase == "running") and 0.4 or 1.0
	for _, data in pairs(self.slots) do
		gui.set_color(data.node, vmath.vector4(EQUIP_COLOR.x, EQUIP_COLOR.y, EQUIP_COLOR.z, alpha))
		gui.set_text(data.label, data.list[data.idx].label)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.status_lbl = gui.get_node("status_lbl")
	self.log_text = gui.get_node("log_text")

	self.btn_play = gui.get_node("btn_play")
	self.btn_pause = gui.get_node("btn_pause")
	self.btn_reset = gui.get_node("btn_reset")

	self.speed_buttons = {
		[1] = gui.get_node("speed_1x"),
		[2] = gui.get_node("speed_2x"),
		[4] = gui.get_node("speed_4x"),
	}
	self.btn_run = gui.get_node("btn_run")

	-- Battle (which fight) and wave (difficulty n) arrow selectors.
	self.lbl_battle = gui.get_node("lbl_battle")
	self.btn_battle_prev = gui.get_node("btn_battle_prev")
	self.btn_battle_next = gui.get_node("btn_battle_next")
	self.lbl_power = gui.get_node("lbl_power")
	self.lbl_wave = gui.get_node("lbl_wave")
	self.btn_wave_prev = gui.get_node("btn_wave_prev")
	self.btn_wave_next = gui.get_node("btn_wave_next")
	self.select_arrows = {
		self.btn_battle_prev, self.btn_battle_next,
		self.btn_wave_prev, self.btn_wave_next,
	}

	-- Equipment selectors: a label box flanked by prev/next arrows.
	self.slots = {
		weapon = {
			list = weapons.get_ui_list(), idx = 1,
			node = gui.get_node("btn_equip_weapon"), label = gui.get_node("lbl_equip_weapon"),
			prev = gui.get_node("btn_weapon_prev"), next = gui.get_node("btn_weapon_next"),
		},
		body = {
			list = skins.get_ui_list("body"), idx = 1,
			node = gui.get_node("btn_equip_body"), label = gui.get_node("lbl_equip_body"),
			prev = gui.get_node("btn_body_prev"), next = gui.get_node("btn_body_next"),
		},
		head = {
			list = skins.get_ui_list("head"), idx = 1,
			node = gui.get_node("btn_equip_head"), label = gui.get_node("lbl_equip_head"),
			prev = gui.get_node("btn_head_prev"), next = gui.get_node("btn_head_next"),
		},
	}

	-- Sensible defaults; the controller refines them via messages on boot.
	self.phase = "idle"
	self.active_speed = 1
	self.run_mode = false
	self.active_battle = 1
	self.wave = 1
	self.player_power = 0
	self.enemy_power = 0

	refresh_play_pause(self)
	refresh_speed(self)
	refresh_run(self)
	refresh_select(self)
	refresh_equip(self)
	refresh_power(self)
end

function on_message(self, message_id, message)
	if message_id == hash("update_logs") then
		gui.set_text(self.log_text, table.concat(message.logs, "\n"))

	elseif message_id == hash("set_status") then
		gui.set_text(self.status_lbl, message.text)
		if message.color then
			gui.set_color(self.status_lbl, message.color)
		end

	elseif message_id == hash("phase_changed") then
		self.phase = message.phase
		refresh_play_pause(self)
		refresh_select(self)
		refresh_equip(self)

	elseif message_id == hash("speed_changed") then
		self.active_speed = message.speed
		refresh_speed(self)

	elseif message_id == hash("run_changed") then
		self.run_mode = message.run
		refresh_run(self)

	elseif message_id == hash("battle_changed") then
		self.active_battle = message.battle
		refresh_select(self)

	elseif message_id == hash("wave_changed") then
		self.wave = message.wave
		refresh_select(self)

	elseif message_id == hash("power_changed") then
		self.player_power = message.player
		self.enemy_power = message.enemy
		refresh_power(self)

	elseif message_id == hash("init_equipment") then
		self.slots.weapon.idx = index_of(self.slots.weapon.list, message.weapon)
		self.slots.body.idx = index_of(self.slots.body.list, message.body)
		self.slots.head.idx = index_of(self.slots.head.list, message.head)
		refresh_equip(self)
	end
end

-- Cycle a loadout slot by dir (+1 next / -1 prev), wrapping, and push to combat.
local function cycle_slot(self, slot, dir)
	local data = self.slots[slot]
	data.idx = ((data.idx - 1 + dir) % #data.list) + 1
	refresh_equip(self)
	msg.post(CONTROLLER, "equip_player", {
		weapon = current_id(self, "weapon"),
		body = current_id(self, "body"),
		head = current_id(self, "head"),
	})
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return
	end

	if gui.pick_node(self.btn_reset, action.x, action.y) then
		flash_node(self.btn_reset)
		msg.post(CONTROLLER, "reset")
		return
	end

	-- PLAY / PAUSE: mutually exclusive, the active one can't be re-pressed.
	if gui.pick_node(self.btn_play, action.x, action.y) then
		if self.phase ~= "running" then
			flash_node(self.btn_play)
			msg.post(CONTROLLER, "play")
		end
		return
	end
	if gui.pick_node(self.btn_pause, action.x, action.y) then
		if self.phase == "running" then
			flash_node(self.btn_pause)
			msg.post(CONTROLLER, "pause")
		end
		return
	end

	-- Speed: pure multiplier, can't re-select the active one.
	for speed_val, btn in pairs(self.speed_buttons) do
		if gui.pick_node(btn, action.x, action.y) then
			if speed_val ~= self.active_speed then
				flash_node(btn)
				msg.post(CONTROLLER, "set_speed", { speed = speed_val })
			end
			return
		end
	end

	-- RUN: plain toggle, unlike speed's mutually-exclusive selection.
	if gui.pick_node(self.btn_run, action.x, action.y) then
		flash_node(self.btn_run)
		msg.post(CONTROLLER, "set_run", { run = not self.run_mode })
		return
	end

	-- Battle / wave: settings, locked during battle.
	if not battle_locked(self) then
		if gui.pick_node(self.btn_battle_prev, action.x, action.y) then
			flash_node(self.btn_battle_prev)
			msg.post(CONTROLLER, "select_battle", { battle = self.active_battle - 1 })
			return
		end
		if gui.pick_node(self.btn_battle_next, action.x, action.y) then
			flash_node(self.btn_battle_next)
			msg.post(CONTROLLER, "select_battle", { battle = self.active_battle + 1 })
			return
		end
		if gui.pick_node(self.btn_wave_prev, action.x, action.y) then
			flash_node(self.btn_wave_prev)
			msg.post(CONTROLLER, "select_wave", { wave = self.wave - 1 })
			return
		end
		if gui.pick_node(self.btn_wave_next, action.x, action.y) then
			flash_node(self.btn_wave_next)
			msg.post(CONTROLLER, "select_wave", { wave = self.wave + 1 })
			return
		end
	end

	-- Loadout arrows: only while not running.
	if self.phase ~= "running" then
		for slot, data in pairs(self.slots) do
			if gui.pick_node(data.prev, action.x, action.y) then
				flash_node(data.prev)
				cycle_slot(self, slot, -1)
				return
			end
			if gui.pick_node(data.next, action.x, action.y) then
				flash_node(data.next)
				cycle_slot(self, slot, 1)
				return
			end
		end
	end
end
