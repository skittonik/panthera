[bootstrap]
main_collection = /first_anim/scenes/autobattle.collectionc
render = /example/default.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1

[android]
input_method = HiddenInputField

[project]
title = Panthera Runtime
version = 5.0
publisher = Insality
developer = Maksim Tuprikov
custom_resources = /first_anim/data/skins.json, /first_anim/data/weapons.json, /first_anim/data/units.json, /first_anim/data/player.json, /first_anim/data/waves.json, /first_anim/data/enemies.json
dependencies#0 = https://github.com/Insality/defold-log/archive/refs/heads/develop.zip
dependencies#1 = https://github.com/Insality/defold-tweener/archive/refs/tags/5.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.2.5.zip
dependencies#3 = https://github.com/Insality/defold-event/archive/refs/heads/develop.zip

[library]
include_dirs = panthera

[panthera]
hotreload_animations = 1

[log]
level = DEBUG
time_tracking = 1
memory_tracking = 1

[html5]
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0
scale_mode = stretch

[render]
clear_color_red = 0.85098
clear_color_green = 0.85098
clear_color_blue = 0.85098
clear_color_alpha = 1.0

[sprite]
max_count = 512

